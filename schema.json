{
  "tables": [
    {
      "name": "users",
      "columns": [
        { "name": "name", "type": "string", "required": true, "min_length": 2, "max_length": 50, "format": "name" },
        { "name": "email", "type": "string", "required": true, "unique": true, "format": "email" },
        { "name": "username", "type": "string", "unique": true, "min_length": 3, "max_length": 20 },
        { "name": "age", "type": "int", "min": 18, "max": 120, "default": 18 },
        { "name": "score", "type": "float", "min": 0.0, "max": 100.0 },
        { "name": "active", "type": "bool", "default": true },
        { "name": "joined", "type": "datetime", "default": "now" },
        { "name": "phone", "type": "string", "format": "phone" },
        { "name": "address", "type": "string", "format": "address" },
        { "name": "city", "type": "string", "format": "city" },
        { "name": "country", "type": "string", "format": "country" },
        { "name": "website", "type": "string", "format": "url" },
        { "name": "user_uuid", "type": "string", "format": "uuid" }
      ]
    },
    {
      "name": "posts",
      "columns": [
        { "name": "title", "type": "string", "required": true, "min_length": 3, "max_length": 120 },
        { "name": "body", "type": "string", "max_length": 2000 },
        { "name": "status", "type": "string", "regex": "^(draft|published|archived)$", "default": "draft" },
        { "name": "user_id", "type": "int", "foreign_key": { "table": "users", "column": "id" } }
      ]
    },
    {
      "name": "comments",
      "columns": [
        { "name": "content", "type": "string", "required": true, "max_length": 500 },
        { "name": "post_id", "type": "int", "foreign_key": { "table": "posts", "column": "id" } },
        { "name": "author_id", "type": "int", "foreign_key": { "table": "users", "column": "id" } }
      ]
    }
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/users/{id}/profile",
      "status": 200,
      "headers": { "X-Mock": "true" },
      "response": {
        "user_id": "{{path.id}}",
        "page": "{{query.page}}",
        "request_id": "{{header.x-request-id}}",
        "name": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "age": { "type": "int", "min": 18, "max": 80 },
        "score": { "type": "float", "min": 0, "max": 100 },
        "active": { "type": "bool" },
        "joined": { "type": "datetime" },
        "tags": { "type": "array", "count": 5, "items": { "type": "string", "max_length": 10 } },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string", "format": "address" },
            "city": { "type": "string" },
            "country": { "type": "string" },
            "coordinates": { "type": "array", "count": 2, "items": { "type": "float", "min": -180, "max": 180 } }
          }
        },
        "server_time": "{{now}}",
        "fixed": "literal value"
      }
    },
    {
      "method": "GET",
      "path": "/stats/overview",
      "response": {
        "type": "array",
        "count": 5,
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string", "format": "city" },
            "value": { "type": "int", "min": 0, "max": 1000 },
            "trend": { "type": "float", "min": -10, "max": 10 }
          }
        }
      }
    },
    {
      "method": "POST",
      "path": "/echo",
      "status": 201,
      "response": {
        "received_name": "{{body.name}}",
        "received_email": "{{body.email}}",
        "echoed": true
      }
    },
    {
      "method": "PUT",
      "path": "/orders/{id}",
      "status": 202,
      "headers": { "X-Rate-Limit": "100" },
      "response": {
        "order_id": "{{path.id}}",
        "status": "accepted",
        "total": { "type": "float", "min": 0, "max": 9999 },
        "confirmed_by": "{{body.confirmed_by}}"
      }
    },
    {
      "method": "PATCH",
      "path": "/tokens/{id}",
      "response": {
        "token_id": "{{path.id}}",
        "updated": true,
        "token": { "type": "string", "format": "uuid" }
      }
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "status": 200,
      "response": {
        "deleted": "{{path.id}}",
        "note": "mock endpoint shadows CRUD DELETE /users/{id}"
      }
    }
  ]
}
